# copy to /etc/systemd/system
# systemctl enable dsmr-mqtt.service

[Unit]
Description=P1 dsmr smartmeter

Requires=network.target
After=network.target
Wants=network-online.target systemd-networkd-wait-online.service

[Service]
Type=idle
ExecStart=/opt/iot/dsmr/dsmr-mqtt.py
#RemainAfterExit=true

# incase log.py and mqtt.py is put in this location
Environment="PYTHONPATH=/opt/python/lib"
Restart=on-failure
RestartSec=60

# All application logging goes to a rotating file on /mnt/ramdisk (see log/log.py)
# to save SD card write cycles. Discard the (duplicate) stdout stream so
# journald doesn't also persist it to disk; keep stderr on its default (journal)
# so an unexpected crash is still visible via `journalctl -u dsmr-mqtt`.
StandardOutput=null

[Install]
WantedBy=network-online.target
